{
  "name": "@meta-agentic/graph-react",
  "version": "0.1.1",
  "description": "Draw any canonical graph model in React: a declarative style specification, layout strategies (force now, layered next), GraphCanvas with pan, zoom and opt-in behaviours, and GraphList, its keyboard-reachable text twin.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "@meta-agentic/graph-model": "0.1.1",
    "d3-force": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meta-agentic/meta-graph",
    "directory": "packages/react"
  },
  "keywords": [
    "graph",
    "graph-visualization",
    "react",
    "d3-force",
    "svg"
  ]
}
